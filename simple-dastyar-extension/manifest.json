{
  "manifest_version": 3,
  "name": "Simple Dastyar Extension",
  "version": "1.1",
  "description": "A new-tab dashboard with search, quick access, and Persian/Gregorian calendar.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
 
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["libs/*.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
